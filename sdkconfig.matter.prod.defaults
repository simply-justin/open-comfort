# Production-only Matter security overlay. Requires manufacturing key custody.
CONFIG_SECURE_BOOT=y
CONFIG_SECURE_BOOT_V2_ENABLED=y
CONFIG_SECURE_FLASH_ENC_ENABLED=y
CONFIG_NVS_ENCRYPTION=y
CONFIG_NVS_SEC_KEY_PROTECT_USING_FLASH_ENC=y
CONFIG_OPENCOMFORT_MATTER_DEVELOPMENT_CREDENTIALS=n
CONFIG_ESP_MATTER_ENABLE_DAC_PROVIDER=y
CONFIG_ESP_MATTER_FACTORY_DATA_PROVIDER=y
