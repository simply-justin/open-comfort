# Matter build. Apply after sdkconfig.defaults; 16 MB layout (add sdkconfig.8mb.defaults for 8 MB).
CONFIG_OPENCOMFORT_PROFILE_MATTER=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-matter-16mb.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_LWIP_IPV6=y
CONFIG_LWIP_IPV6_AUTOCONFIG=y
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_MBEDTLS_HKDF_C=y
CONFIG_CUSTOM_NETWORK_CONFIG=y
CONFIG_ENABLE_OTA_REQUESTOR=y
CONFIG_ESP_MATTER_NVS_PART_NAME="matter"
CONFIG_CHIP_FACTORY_NAMESPACE_PARTITION_LABEL="fctry"
CONFIG_CHIP_CONFIG_NAMESPACE_PARTITION_LABEL="matter"
CONFIG_CHIP_COUNTERS_NAMESPACE_PARTITION_LABEL="matter"
CONFIG_CHIP_KVS_NAMESPACE_PARTITION_LABEL="matter"
CONFIG_SUPPORT_THERMOSTAT_CLUSTER=y
CONFIG_SUPPORT_CLOSURE_CONTROL_CLUSTER=n
CONFIG_SUPPORT_CLOSURE_DIMENSION_CLUSTER=n
CONFIG_ENABLE_CHIP_SHELL=n
# Share the ESP-IDF mDNS stack with the portal's opencomfort-xxxx.local name;
# minimal mDNS would compete for UDP port 5353.
CONFIG_USE_MINIMAL_MDNS=n
# A panic keeps a core dump in the 64 KB coredump partition; the next boot logs its summary
# (task, PC, backtrace) in Settings > Logs and erases it. Few tasks so the dump fits.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_MAX_TASKS_NUM=8
