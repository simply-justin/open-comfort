{
  "C_Cpp.intelliSenseEngine": "default",
  "idf.openOcdConfigs": [
    "board/esp32s3-builtin.cfg"
  ],
  "idf.port": "/dev/ttyS0",
  "idf.customExtraVars": {
    "IDF_TARGET": "esp32s3"
  },
  "clangd.arguments": [
    "--background-index",
    "--query-driver=**/xtensa-esp-elf-*",
    "--compile-commands-dir=${workspaceFolder}/build"
  ],
  "files.associations": {
    "*.embeddedhtml": "html",
    "vector": "cpp",
    "complex": "cpp"
  }
}
